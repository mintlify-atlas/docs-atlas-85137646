  "keyFeatures": [
    "Real-time scheduling-time cost estimates with annualised figures for recurring meetings",
    "Post-meeting summaries based on actual attendance and actual duration",
    "Weekly and monthly cost digests by team and org-wide with CSV export",
    "Pay data encrypted at rest with AES-256-GCM under an operator-supplied key",
    "Role-based disclosure controls with salary-inference protections for small meetings",
    "Full audit log of every pay-data access",
    "Egress allowlist enforced at the socket layer — no payroll data leaves the deployment",
    "Adapters for Google Workspace, Microsoft 365, Zoom directories, and BambooHR HRIS",
    "Helm chart and Docker Compose for self-hosted deployment",
    "CLI for key generation, database seeding, syncs, digests, and pay import"
  ],
  "publicApiSurface": [
